# Supabase -> Project Settings -> Database -> Connection string
# Pooled connection (Transaction pooler, port 6543) used by the running app
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Direct connection (port 5432) used by `prisma db push`
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# The first account can always be created. Set to "true" only if you want to allow more sign-ups later.
ALLOW_SIGNUP="false"
